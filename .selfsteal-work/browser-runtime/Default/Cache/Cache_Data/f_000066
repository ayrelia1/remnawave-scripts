body{font-family:"Segoe UI", Arial, sans-serif;line-height:1.6}h1,h2,h3{font-family:"Segoe UI", Arial, sans-serif}button,a,select,summary,input[type=submit]{cursor:pointer}button:disabled{cursor:default}button:hover:not(:disabled){filter:brightness(1.08)}:focus-visible{outline:3px solid var(--site-accent);outline-offset:4px}textarea{resize:none}::-webkit-scrollbar{width:12px;height:12px}::-webkit-scrollbar-track{background:var(--site-paper)}::-webkit-scrollbar-thumb{background:var(--site-accent);border:3px solid var(--site-paper);border-radius:8px}::-webkit-scrollbar-thumb:hover{background:var(--site-ink)}
header{background:#f1f2f9f5!important;border-bottom:1px solid #d6d4e8;box-shadow:none!important}header a{letter-spacing:-.015em}main>div:first-child{background:linear-gradient(120deg,#e7e4f5,#f7f8fc)!important}main h1{color:var(--site-ink)!important;background:none!important;letter-spacing:-.055em;max-width:15ch;margin-inline:auto;font-weight:600}#features{border-top:1px solid #d6d4e8}section h2{letter-spacing:-.035em}[class*="rounded-xl"]{border-radius:.6rem!important}#formats{background:#e7e4f566!important}#pricing{border-block:1px solid #d6d4e8}footer{background:var(--site-ink)!important} @media(min-width:900px){#features .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.6rem}#features .grid>div{border-left:3px solid var(--site-accent);padding-left:1.5rem}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}@media(forced-colors:active){:focus-visible{outline:2px solid Highlight}*{scrollbar-color:auto}}

